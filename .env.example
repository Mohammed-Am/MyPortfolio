# Configure these in Hostinger's Node.js app settings and locally in .env.local.
APP_URL=https://amouzoun.dev
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server only. Never use a NEXT_PUBLIC_ prefix for these settings.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
ADMIN_USER_ID=uuid-of-your-supabase-auth-user
